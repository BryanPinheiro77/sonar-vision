    {"name": "missing_observation", "input": "valid_audio", "context": "obs-42 não registrada", "expected": "discarded: missing_observation"},
    {"name": "timestamp_mismatch", "input": "valid_audio", "replace": {"captured_at_ms": 10500}, "context": "Registro local frame-42=10000", "expected": "discarded: capture_mismatch"},
