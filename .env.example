# API de inferência (#24). Copie para .env apenas valores locais; não versione .env.
# Placeholders: nenhum valor real de credencial deve aparecer aqui.
SONAR_API_BACKEND=simulated
SONAR_API_TOKENS_FILE=.local/tokens
# SONAR_API_WEIGHTS=models/yolov8n.pt
SONAR_API_MAX_BODY_BYTES=524288
SONAR_API_MAX_PIXELS=1920000
SONAR_API_TIMEOUT_MS=1500
SONAR_API_MAX_SESSIONS=8
SONAR_API_IDLE_SECONDS=60
# Pacote de vozes liberado (#26), fora do Git; sem ele, /v1/catalog/* responde catalog_unavailable.
# SONAR_API_CATALOG_DIR=.local/catalog/1.0.0

# Execução em contêiner (#28; docs/packaging.md). O Compose lê este arquivo apenas
# para interpolação; caminhos abaixo são do host e ficam fora do Git.
SONAR_HOST_TLS_DIR=./.local/tls
SONAR_HOST_TOKENS_FILE=./.local/tokens
SONAR_HOST_MODELS_DIR=./models
SONAR_API_PORT=8443
# Variante com detector real: SONAR_BUILD_EXTRAS=api,vision e pesos obtidos conforme docs/vision.md.
# SONAR_BUILD_EXTRAS=api,vision
# SONAR_API_WEIGHTS_IN_CONTAINER=/models/yolov8n.pt
# Linux: id do seu usuário, para o contêiner ler a chave TLS (modo 600).
# SONAR_UID=1000
# SONAR_GID=1000
# SONAR_HOST_CATALOG_DIR=./.local/catalog/1.0.0   # usado só com compose.catalog.yaml

# #52: opções experimentais, explicitamente configuradas; sem mudança no wire.
# SONAR_API_WEIGHTS_SHA256=<sha256-do-peso-geral-confiavel>
# SONAR_API_STAIR_WEIGHTS=models/stairs-up-down-v3.pt
# SONAR_API_STAIR_WEIGHTS_SHA256=<sha256-do-peso-de-escadas-confiavel>
# SONAR_API_AUDIO_CONFIG=.local/evaluation/audio.json
# SONAR_API_DIAGNOSTICS_DIR=.local/diagnostics
# Compose: segundo modelo no volume /models; avaliação usa compose.evaluation.yaml.
# SONAR_API_STAIR_WEIGHTS_IN_CONTAINER=/models/stairs-up-down-v3.pt
# SONAR_HOST_EVALUATION_DIR=./.local/evaluation
# SONAR_HOST_DIAGNOSTICS_DIR=./.local/diagnostics

# R20 (#52): handoff local experimental, não baixado pelo script público de v3.
# SONAR_API_STAIR_WEIGHTS=models/stairs-specialist-r20-candidate.pt
# SONAR_API_STAIR_WEIGHTS_IN_CONTAINER=/models/stairs-specialist-r20-candidate.pt
# Confira seu hash em docs/experiments/integration-52-r20.json.
